# Public app URL (production)
NEXT_PUBLIC_APP_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SETUP_SECRET=
TELEGRAM_WEBHOOK_SECRET=
# Optional override; defaults to the NOURA Supabase Edge Function
SUPABASE_TELEGRAM_WEBHOOK_URL=

# WHOOP OAuth (server-side only)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_SESSION_SECRET=

# NOURA Coach AI (optional; falls back to local recommendations if omitted)
OPENAI_API_KEY=
NOURA_AI_MODEL=gpt-5.6-luna

# Minimal notification state (Upstash Redis / Vercel KV-compatible REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel KV aliases also supported:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protects Vercel Cron when configured
CRON_SECRET=
